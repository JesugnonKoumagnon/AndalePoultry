{
  "name": "Mortalite",
  "type": "object",
  "properties": {
    "bande_id": {
      "type": "string",
      "description": "ID de la bande"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date de l'\u00e9v\u00e9nement"
    },
    "nombre": {
      "type": "number",
      "description": "Nombre de morts"
    },
    "cause": {
      "type": "string",
      "enum": [
        "maladie",
        "chaleur",
        "predateur",
        "accident",
        "inconnue"
      ],
      "description": "Cause de la mortalit\u00e9"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "bande_id",
    "date",
    "nombre"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}